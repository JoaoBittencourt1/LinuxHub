# Task 1.1/1.6/1.8: unidade que executa o instalador. Único ponto de entrada
# desta mídia (design.md D0) — não depende de nenhum gancho de família de
# live (casper/live-config script=), é a mesma unidade sempre.
#
# after=live-config garante que a sessão live terminou de se configurar
# (hostname, etc.) antes do instalador assumir o console. Não depende de
# rede: a instalação é totalmente offline (Non-Goal do design.md).
[Unit]
Description=LinuxHub - instalador desatendido
After=live-config.service getty@tty1.service
Conflicts=getty@tty1.service
Wants=live-config.service

[Service]
Type=simple
ExecStart=/opt/linuxhub/bin/run-installer.sh
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYPath=/dev/tty1

# TTYReset/TTYVHangup/TTYVTDisallocate ficam DESLIGADOS até a fase 11 passar.
# Eles resetam e desalocam o console ao iniciar a unidade — ou seja, LIMPAM a
# tela, apagando qualquer coisa impressa antes e logo depois. Durante o
# diagnóstico isso é exatamente o efeito errado: foi provavelmente o que fez a
# caixa de início "piscar e sumir" num teste real. São acabamento (console
# limpo para o usuário final), e acabamento não pode competir com a informação
# de onde a instalação parou.

# Registra o desfecho DIRETO na tty1, aconteça o que acontecer com a saída
# padrão. Sem isto, "a unidade não rodou" e "a unidade rodou e morreu" são
# visualmente idênticos — os dois são uma tela preta — e essa ambiguidade
# custou vários ciclos de teste em VM.
ExecStopPost=/bin/sh -c 'echo "" > /dev/tty1; echo "[linuxhub-installer] unidade encerrou: result=$SERVICE_RESULT exit=$EXIT_CODE/$EXIT_STATUS" > /dev/tty1'

Restart=no

[Install]
WantedBy=multi-user.target
