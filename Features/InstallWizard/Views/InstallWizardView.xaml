<UserControl x:Class="LinuxHub.Features.InstallWizard.Views.InstallWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:LinuxHub.Common.Localization"
             xmlns:conv="clr-namespace:LinuxHub.Features.InstallWizard.Views.Converters"
             xmlns:models="clr-namespace:LinuxHub.Common.Models"
             xmlns:fx="clr-namespace:LinuxHub.Common.Ui"
             xmlns:views="clr-namespace:LinuxHub.Features.InstallWizard.Views">

    <UserControl.Resources>
        <sys:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:EnumMatchConverter x:Key="EnumMatch"/>
        <conv:FalseToVisibleConverter x:Key="FalseToVisible"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">

                <TextBlock Text="{loc:Loc Wizard_Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                <!-- Fica aqui, e não no shell, porque é uma ressalva sobre a ESCOLHA da
                     distro: o catálogo lista várias, mas só uma foi validada de ponta a
                     ponta. O aviso geral de risco do projeto está no MainWindow. -->
                <ui:InfoBar Margin="0,0,0,16"
                            Severity="Warning"
                            IsOpen="True"
                            IsClosable="False"
                            Title="{loc:Loc Wizard_TestedDistroWarningTitle}"
                            Message="{loc:Loc Wizard_TestedDistroWarningMessage}"/>

                <!-- ISO e distro -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_IsoSectionTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="{loc:Loc Wizard_DownloadHereOption}"
                                         IsChecked="{Binding Iso.IsManualSelect, Converter={StaticResource InverseBool}}"
                                         Margin="0,0,20,0"/>
                            <RadioButton Content="{loc:Loc Wizard_SelectManuallyOption}"
                                         IsChecked="{Binding Iso.IsManualSelect}"/>
                        </StackPanel>

                        <!-- ISO manual -->
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding Iso.IsManualIsoVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        IsReadOnly="True"
                                        PlaceholderText="{loc:Loc Wizard_NoIsoSelected}"
                                        Text="{Binding Iso.ManualIsoPath, Mode=OneWay}"/>

                            <ui:Button Grid.Column="1"
                                       Content="{loc:Loc Wizard_SearchButton}"
                                       Margin="8,0,0,0"
                                       Click="BrowseIso_Click"/>
                        </Grid>

                        <!-- Verificação da ISO selecionada manualmente: só uma leitura completa
                             do arquivo prova a integridade dele, e isso pode levar dezenas de
                             segundos numa ISO de vários GB — sem isto a UI pareceria travada. -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Iso.IsVerifyingManualIso, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="260" Value="{Binding Iso.ManualVerificationPercent, Mode=OneWay}"/>
                            <TextBlock Text="{loc:Loc Wizard_VerifyingIsoLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ISOs já baixadas: só aparece sozinha (sem o combo de baixar outra
                             junto) pra não deixar dois campos disputando qual ISO vale. -->
                        <StackPanel Visibility="{Binding Iso.IsDownloadedIsosVisible, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc Wizard_DownloadedIsosLabel}" Opacity="0.7" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="320"
                                          ItemsSource="{Binding Iso.DownloadedIsos}"
                                          SelectedItem="{Binding Iso.SelectedDownloadedIso}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Distro.Name}"/>
                                                <TextBlock Text="{Binding DownloadedAtUtc, StringFormat=' — dd/MM/yyyy HH:mm'}" Opacity="0.6" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ui:Button Content="{loc:Loc Wizard_DownloadAnotherIsoButton}"
                                           Margin="10,0,0,0"
                                           Command="{Binding Iso.DownloadAnotherIsoCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Escolher distro pra baixar: só aparece quando ainda não há ISO
                             nenhuma baixada, ou quando o usuário pediu pra baixar outra. -->
                        <StackPanel Visibility="{Binding Iso.IsDistroPickerVisible, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc Wizard_SelectedDistributionLabel}" Opacity="0.7" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Sem DisplayMemberPath: cada item carrega o ícone de risco
                                     das distros nunca testadas (DistroInfo.IsTested), para a
                                     escolha já nascer informada em vez de o usuário descobrir
                                     depois de reiniciar. -->
                                <ComboBox Width="220"
                                          ItemsSource="{Binding Iso.Distros}"
                                          SelectedItem="{Binding Iso.SelectedDistro}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Warning24"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"
                                                               ToolTipService.ToolTip="{loc:Loc Wizard_UntestedDistroTooltip}"
                                                               Visibility="{Binding IsTested, Converter={StaticResource FalseToVisible}}"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ui:Button Content="{loc:Loc Wizard_DownloadIsoButton}"
                                           Appearance="Primary"
                                           Margin="10,0,0,0"
                                           Command="{Binding Iso.DownloadIsoCommand}"
                                           Visibility="{Binding Iso.IsDownloadButtonVisible, Converter={StaticResource BoolToVis}}"/>

                                <ui:Button Content="{loc:Loc Wizard_CancelDownloadButton}"
                                           Margin="10,0,0,0"
                                           Command="{Binding Iso.CancelDownloadCommand}"
                                           Visibility="{Binding Iso.IsDownloading, Converter={StaticResource BoolToVis}}"/>

                                <ui:Button Content="{loc:Loc Wizard_BackToDownloadedIsoButton}"
                                           Margin="10,0,0,0"
                                           Command="{Binding Iso.UseDownloadedIsoCommand}"
                                           Visibility="{Binding Iso.IsBackToDownloadedVisible, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Substitui o botão de download quando a distro escolhida não tem
                                 hash de referência publicado — a UI explica o motivo em vez de
                                 só sumir com o botão (artifact-integrity spec). -->
                            <TextBlock Text="{loc:Loc Wizard_DistroNotVerifiableMessage}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       Visibility="{Binding Iso.IsSelectedDistroUnverifiable, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Progresso -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,10"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Iso.IsDownloading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Width="260"
                                         Value="{Binding Iso.DownloadPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding Iso.IsDownloadIndeterminate, Mode=OneWay}"/>
                            <TextBlock Text="{Binding Iso.DownloadStatusText, Mode=OneWay}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Instalação automática: só existe pra distro já validada de ponta
                             a ponta (ver DistroInfo.SupportsAutoinstall) — pras demais o wizard
                             só prepara o boot até o instalador nativo, sem essa opção. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding Iso.IsAutoinstallToggleVisible, Converter={StaticResource BoolToVis}}">
                            <ui:ToggleSwitch IsChecked="{Binding Iso.UseAutoinstall}">
                                <ui:ToggleSwitch.Content>
                                    <TextBlock Text="{loc:Loc Wizard_AutoinstallToggleLabel}"
                                               TextWrapping="Wrap"
                                               MaxWidth="560"/>
                                </ui:ToggleSwitch.Content>
                            </ui:ToggleSwitch>
                        </StackPanel>

                        <!-- Versão incerta: só quando a ISO foi selecionada manualmente e o
                             nome do arquivo não bate com a versão testada do catálogo (ex.: um
                             Ubuntu 26 contra o 24.04 validado) — não trava nada, só avisa. -->
                        <ui:InfoBar Margin="0,0,0,10"
                                    Severity="Warning"
                                    IsOpen="{Binding Iso.IsAutoinstallVersionWarningVisible}"
                                    IsClosable="False"
                                    Title="{loc:Loc Wizard_AutoinstallVersionWarningTitle}"
                                    Message="{loc:Loc Wizard_AutoinstallVersionWarningMessage}"/>

                        <!-- Confirmação: qual ISO vai ser de fato usada na instalação, não
                             importa se veio de seleção manual, lista de já baixadas ou de um
                             download que acabou de terminar — um único lugar pra conferir.
                             Grid em vez de StackPanel horizontal: um StackPanel horizontal mede
                             o filho com largura infinita, então o TextBlock nunca quebrava linha
                             e vazava pra fora da tela nas mensagens mais longas. -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TargetNullValue: sem distro detectada o caminho é null, e o
                                 ImageSourceConverter padrão não converte null — o binding
                                 falhava com NotSupportedException a cada avaliação. -->
                            <Image Grid.Column="0"
                                   Width="24" Height="24"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Top"
                                   Source="{Binding Iso.DisplayedDistro.ImagePath, TargetNullValue={x:Null}}"
                                   Visibility="{Binding Iso.IsIsoReadyForInstall, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Iso.SelectedIsoStatusText}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Opacity="0.9"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Tipo de instalação -->
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_InstallTypeTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,10"/>

                        <RadioButton Content="{loc:Loc Wizard_ReplaceOption}"
                                     IsChecked="{Binding Target.Mode, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:InstallMode.Replace}}"/>

                        <RadioButton Content="{loc:Loc Wizard_DualBootOption}"
                                     Margin="0,6,0,0"
                                     IsChecked="{Binding Target.Mode, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:InstallMode.DualBoot}}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Disco (substituir) -->
                <ui:Card Margin="0,0,0,16"
                         Visibility="{Binding Target.IsReplaceMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_TargetDiskTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Wizard_TargetDiskHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Target.Disks}" SelectedItem="{Binding Target.SelectedDisk}"/>

                        <ui:InfoBar IsOpen="{Binding Target.HasDiskDetectionError}"
                                    IsClosable="False"
                                    Severity="Error"
                                    Message="{Binding Target.DiskDetectionError}"
                                    Margin="0,8,0,0"/>

                        <ui:InfoBar IsOpen="{Binding Target.IsReplacingSystemDisk}"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Message="{loc:Loc Wizard_ReplaceSystemDiskWarningMessage}"
                                    Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Partição (dual-boot) -->
                <ui:Card Margin="0,0,0,16"
                         Visibility="{Binding Target.IsDualBootMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_DualBootPartitionTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Wizard_DualBootPartitionHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Target.Partitions}" SelectedItem="{Binding Target.SelectedPartition}"/>

                        <ui:InfoBar IsOpen="{Binding Target.HasPartitionDetectionError}"
                                    IsClosable="False"
                                    Severity="Error"
                                    Message="{Binding Target.PartitionDetectionError}"
                                    Margin="0,8,0,0"/>

                        <ui:InfoBar IsOpen="{Binding Target.HasPartitionSpaceError}"
                                    IsClosable="False"
                                    Severity="Error"
                                    Message="{Binding Target.PartitionSpaceError}"
                                    Margin="0,8,0,0"/>

                        <TextBlock Text="{loc:Loc Wizard_ReservedSpaceLabel}" Margin="0,12,0,0"/>
                        <Slider x:Name="LinuxSizeSlider"
                                Minimum="{Binding Target.SliderMinimum}"
                                Maximum="{Binding Target.SliderMaximum}"
                                Value="{Binding Target.LinuxPartitionSizeGb}"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Opacity="0.7"
                                   HorizontalAlignment="Right"
                                   Text="{Binding ElementName=LinuxSizeSlider, Path=Value, StringFormat={}{0} GB}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Usuário: só existe pro fluxo de autoinstall — sem ele é o instalador
                     nativo da ISO que vai perguntar isso. -->
                <ui:Card Margin="0,0,0,16"
                         Visibility="{Binding IsAccountStepVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_UserSectionTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,10"/>

                        <ui:TextBox PlaceholderText="{loc:Loc Wizard_UsernamePlaceholder}"
                                    Text="{Binding Account.Username, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,8"/>

                        <ui:PasswordBox x:Name="PasswordBox"
                                        PlaceholderText="{loc:Loc Wizard_PasswordPlaceholder}"
                                        RevealButtonEnabled="True"
                                        PasswordChanged="PasswordBox_PasswordChanged"
                                        Margin="0,0,0,8"/>

                        <ui:PasswordBox x:Name="ConfirmPasswordBox"
                                        PlaceholderText="{loc:Loc Wizard_ConfirmPasswordPlaceholder}"
                                        RevealButtonEnabled="True"
                                        PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                        Margin="0,0,0,4"/>

                        <TextBlock Text="{loc:Loc Wizard_PasswordMismatch}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding Account.PasswordsMismatch, Converter={StaticResource BoolToVis}}"/>

                        <ui:TextBox PlaceholderText="{loc:Loc Wizard_PcNamePlaceholder}"
                                    Text="{Binding Account.Hostname, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Idioma, teclado e fuso: como a conta, só existe pro fluxo de autoinstall —
                     sem ele quem pergunta isso é o instalador nativo da ISO. Os três campos
                     nascem com o que foi detectado do Windows e podem ser corrigidos; o valor
                     que aparece aqui é o que vai para a instalação. -->
                <ui:Card Margin="0,0,0,16"
                         Visibility="{Binding IsRegionalStepVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_RegionalSectionTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Wizard_RegionalSectionHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Alguma das três não teve correspondência e está mostrando o padrão
                             declarado do mapeamento. Não bloqueia nada: só torna visível o que
                             antes era um valor chumbado que ninguém via. -->
                        <ui:InfoBar IsOpen="{Binding Regional.HasUndetectedSetting, Mode=OneWay}"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Message="{loc:Loc Wizard_RegionalFallbackWarningMessage}"
                                    Margin="0,0,0,10"/>

                        <TextBlock Text="{loc:Loc Wizard_LocaleLabel}" Opacity="0.7" Margin="0,0,0,6"/>
                        <ComboBox Margin="0,0,0,10"
                                  ItemsSource="{Binding Regional.AvailableLocales}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Regional.Locale}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NativeName}"/>
                                        <TextBlock Text="{Binding Value}" Opacity="0.6" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{loc:Loc Wizard_KeymapLabel}" Opacity="0.7" Margin="0,0,0,6"/>
                        <ComboBox Margin="0,0,0,10"
                                  ItemsSource="{Binding Regional.AvailableKeymaps}"
                                  SelectedItem="{Binding Regional.Keymap}"/>

                        <TextBlock Text="{loc:Loc Wizard_TimezoneLabel}" Opacity="0.7" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Regional.AvailableTimezones}"
                                  SelectedItem="{Binding Regional.Timezone}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Ambiente gráfico: só aparece para distro cujo MECANISMO declarado suporta a
                     escolha. A maioria das ISOs já embute um ambiente, e oferecer uma opção que
                     seria ignorada promete um controle que o usuário não tem. Os nomes próprios
                     são dado (§4); os rótulos ao redor vêm dos .resx. -->
                <ui:Card Margin="0,0,0,16"
                         Visibility="{Binding IsDesktopEnvironmentStepVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Wizard_DesktopEnvironmentTitle}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Wizard_DesktopEnvironmentHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <ComboBox ItemsSource="{Binding Regional.AvailableDesktopEnvironments}"
                                  DisplayMemberPath="ProfileName"
                                  SelectedValuePath="ProfileName"
                                  SelectedValue="{Binding Regional.DesktopEnvironment}"/>
                    </StackPanel>
                </ui:Card>

                <ui:InfoBar IsOpen="True"
                            IsClosable="False"
                            Severity="Warning"
                            Message="{loc:Loc Wizard_WarningBanner}"
                            Margin="0,0,0,16"/>

                <Border Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                    <views:ConfirmationView DataContext="{Binding PendingConfirmation}"/>
                </Border>

                <Border Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                    <ui:Button Content="{loc:Loc Wizard_InstallButton}"
                               Appearance="Success"
                               Icon="{ui:SymbolIcon Play24}"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Height="52"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,24"
                               fx:PressFeedback.Enabled="True"
                               fx:AttentionPulse.Enabled="True"
                               fx:AttentionPulse.GlowColor="#FF16C60A"
                               Command="{Binding InstallCommand}"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Tela de progresso da instalação. Overlay em vez de um cartão no fluxo porque
             também precisa BLOQUEAR a interação: o Border tem Background, então come os
             cliques em tudo que está atrás. Mexer no alvo ou no tamanho com um shrink já
             em andamento não teria efeito algum e só confundiria. -->
        <Border Background="#CC000000"
                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
            <ui:Card MaxWidth="520"
                     Margin="24"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <StackPanel>
                    <ui:ProgressRing IsIndeterminate="True"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding InstallStatus}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <TextBlock Text="{loc:Loc Wizard_InstallProgressHint}"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>

                    <!-- Log acumulado: cada passo relatado vira uma linha, nunca sobrescrita —
                         é o que deixa visível o que está sendo feito, e não só o passo atual. -->
                    <Border Background="#14FFFFFF"
                            CornerRadius="4"
                            Margin="0,14,0,0"
                            Padding="10,8"
                            MaxHeight="160">
                        <ScrollViewer x:Name="InstallLogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding InstallLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Opacity="0.85"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:Card>
        </Border>
    </Grid>
</UserControl>
