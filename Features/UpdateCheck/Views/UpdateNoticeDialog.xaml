<ui:FluentWindow x:Class="LinuxHub.Features.UpdateCheck.Views.UpdateNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:LinuxHub.Common.Localization"
        x:ClassModifier="internal"
        Title="{loc:Loc UpdateNotice_Title}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Loc UpdateNotice_Title}"
                     ShowMaximize="False"
                     ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="24,8,24,20">
            <ui:SymbolIcon Symbol="ArrowDownload24"
                           FontSize="32"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,12"/>

            <TextBlock Text="{loc:Loc UpdateNotice_Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{loc:Loc UpdateNotice_Message}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding VersionsText}"
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       FontSize="12"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{loc:Loc UpdateNotice_Dismiss}"
                           Appearance="Secondary"
                           MinWidth="110"
                           Margin="0,0,8,0"
                           Command="{Binding DismissCommand}"/>

                <ui:Button Content="{loc:Loc UpdateNotice_Download}"
                           Appearance="Primary"
                           MinWidth="150"
                           IsDefault="True"
                           Command="{Binding DownloadCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
