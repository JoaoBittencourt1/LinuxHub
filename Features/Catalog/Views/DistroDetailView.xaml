<UserControl x:Class="LinuxHub.Features.Catalog.Views.DistroDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:LinuxHub.Common.Localization"
             xmlns:conv="clr-namespace:LinuxHub.Features.Catalog.Views.Converters">

    <UserControl.Resources>
        <conv:RatingToStarsConverter x:Key="RatingToStars"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Botão de voltar -->
        <ui:Button Content="{loc:Loc CatalogDetail_Back}"
                   Command="{Binding BackCommand}"
                   Icon="{ui:SymbolIcon ArrowLeft24}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Panel.ZIndex="10"
                   Margin="0,0,0,10"/>

        <!-- Imagem da distro -->
        <ui:Card Grid.Column="0" Margin="0,50,10,0">
            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
        </ui:Card>

        <!-- Painel de informações -->
        <StackPanel Grid.Column="1" Margin="20,50,0,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding Name}"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <!-- Aviso de distro não testada: vem antes de tudo (inclusive da descrição) de
                 propósito — quem abre esta tela está decidindo se instala, e a decisão muda
                 se o app nunca foi exercitado nessa distro. Severity="Error" e não "Warning"
                 porque a consequência possível é a máquina não iniciar. -->
            <ui:InfoBar Severity="Error"
                        IsOpen="True"
                        IsClosable="False"
                        Margin="0,0,0,14"
                        Title="{loc:Loc CatalogDetail_UntestedWarningTitle}"
                        Message="{loc:Loc CatalogDetail_UntestedWarningMessage}"
                        Visibility="{Binding IsUntested, Converter={StaticResource BoolToVis}}"/>

            <!-- Metadados: origem e mantenedor -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{loc:Loc CatalogDetail_CreatedLabel}" FontSize="12" Opacity="0.6" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding CreatedYear}" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"/>
                <TextBlock Text="{loc:Loc CatalogDetail_MaintainerLabel}" FontSize="12" Opacity="0.6" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Maintainer}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Text="{Binding Description}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,14"/>

            <!-- Recomendação para iniciantes -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="{loc:Loc CatalogDetail_BeginnerLabel}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding BeginnerRating, Converter={StaticResource RatingToStars}}"
                           FontSize="16"
                           Foreground="Goldenrod"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Carrossel -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Width="32"
                           Height="32"
                           Icon="{ui:SymbolIcon ChevronLeft24}"
                           Command="{Binding PrevCommand}"/>

                <ContentControl x:Name="CarouselContent"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="340"
                                Height="300"/>

                <ui:Button Grid.Column="2"
                           Width="32"
                           Height="32"
                           Icon="{ui:SymbolIcon ChevronRight24}"
                           Command="{Binding NextCommand}"/>
            </Grid>

            <!-- Instalar agora: leva ao painel de instalação já apontado pra esta distro -->
            <ui:Button Content="{loc:Loc CatalogDetail_InstallNowButton}"
                       Command="{Binding InstallNowCommand}"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Desktop24}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Height="40"
                       Margin="0,0,0,14"/>

            <!-- Download -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc CatalogDetail_DownloadLabel}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:HyperlinkButton Content="{loc:Loc CatalogDetail_DownloadLinkText}"
                                     Command="{Binding OpenDownloadLinkCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
