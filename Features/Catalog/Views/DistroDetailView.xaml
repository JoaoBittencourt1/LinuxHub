<UserControl x:Class="LinuxHub.Features.Catalog.Views.DistroDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:LinuxHub.Common.Localization"
             xmlns:conv="clr-namespace:LinuxHub.Features.Catalog.Views.Converters">

    <UserControl.Resources>
        <conv:RatingToStarsConverter x:Key="RatingToStars"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Botão de voltar -->
        <ui:Button Content="{loc:Loc CatalogDetail_Back}"
                   Command="{Binding BackCommand}"
                   Icon="{ui:SymbolIcon ArrowLeft24}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Panel.ZIndex="10"
                   Margin="0,0,0,8"/>

        <!-- Imagem da distro -->
        <ui:Card Grid.Column="0" Margin="0,40,10,0">
            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
        </ui:Card>

        <!-- Painel de informações dividido em quadros (ui:Card), um por assunto — nome,
             metadados, descrição, screenshots e ações ficam visualmente separados em vez
             de correr soltos num único bloco de texto. Espaçamento entre quadros é enxuto
             de propósito, para que tudo caiba junto na janela padrão sem precisar rolar; o
             ScrollViewer continua como rede de segurança para quando a janela é
             redimensionada abaixo do normal. -->
        <ScrollViewer Grid.Column="1"
                      Margin="20,40,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Top">

                <!-- Quadro 1: nome + metadados em tabela (label | valor), linhas separadas
                     por um traço fino — mais fácil de escanear que texto corrido. -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc CatalogDetail_CreatedLabel}" FontSize="11" Opacity="0.6" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedYear}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="White" Opacity="0.08"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc CatalogDetail_MaintainerLabel}" FontSize="11" Opacity="0.6" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Maintainer}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Height="1" Fill="White" Opacity="0.08"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc CatalogDetail_BeginnerLabel}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BeginnerRating, Converter={StaticResource RatingToStars}}" FontSize="13" Foreground="Goldenrod" Margin="0,4,0,4"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Aviso de distro não testada: fora dos quadros de propósito — a cor de
                     alerta já é o suficiente para destacar, e ele vem antes da descrição
                     porque quem chegou aqui está decidindo se instala, e a decisão muda se
                     o app nunca foi exercitado nessa distro. Severity="Error" e não
                     "Warning" porque a consequência possível é a máquina não iniciar. -->
                <ui:InfoBar Severity="Error"
                            IsOpen="True"
                            IsClosable="False"
                            Margin="0,0,0,8"
                            Title="{loc:Loc CatalogDetail_UntestedWarningTitle}"
                            Message="{loc:Loc CatalogDetail_UntestedWarningMessage}"
                            Visibility="{Binding IsUntested, Converter={StaticResource BoolToVis}}"/>

                <!-- Quadro 2: descrição -->
                <ui:Card Margin="0,0,0,8" Padding="12">
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Opacity="0.85"/>
                </ui:Card>

                <!-- Quadro 3: screenshots -->
                <ui:Card Margin="0,0,0,8" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0"
                                   Width="28"
                                   Height="28"
                                   Icon="{ui:SymbolIcon ChevronLeft24}"
                                   Command="{Binding PrevCommand}"/>

                        <ContentControl x:Name="CarouselContent"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="290"
                                        Height="140"/>

                        <ui:Button Grid.Column="2"
                                   Width="28"
                                   Height="28"
                                   Icon="{ui:SymbolIcon ChevronRight24}"
                                   Command="{Binding NextCommand}"/>
                    </Grid>
                </ui:Card>

                <!-- Quadro 4: ações — instalar e baixar no site oficial -->
                <ui:Card Padding="12">
                    <StackPanel>
                        <ui:Button Content="{loc:Loc CatalogDetail_InstallNowButton}"
                                   Command="{Binding InstallNowCommand}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Desktop24}"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Height="36"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{loc:Loc CatalogDetail_DownloadLabel}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,0,0,2"/>
                        <ui:HyperlinkButton Content="{loc:Loc CatalogDetail_DownloadLinkText}"
                                             Command="{Binding OpenDownloadLinkCommand}"
                                             HorizontalAlignment="Left"
                                             Padding="0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
