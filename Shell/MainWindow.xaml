<ui:FluentWindow x:Class="LinuxHub.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:LinuxHub.Common.Localization"
        xmlns:anim="clr-namespace:LinuxHub.Common.Animations"
        Title="{loc:Loc Shell_Title}"
        Height="640"
        Width="1040"
        MinHeight="480"
        MinWidth="760"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">

    <!-- RootGrid é o alvo do fade que marca a troca de tema: a substituição do
         dicionário de cores é instantânea, e sem esse pulso ela pisca na tela. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{loc:Loc Shell_Title}" Grid.Row="0">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="VersionText"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Opacity="0.6"
                               FontSize="11"/>
                    <ui:Button x:Name="ThemeButton"
                               Appearance="Transparent"
                               anim:Hover.Effect="Pop"
                               ToolTip="{loc:Loc Shell_ThemeTooltip}"
                               Click="ThemeButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon x:Name="ThemeIcon"
                                           Symbol="WeatherMoon24"
                                           RenderTransformOrigin="0.5,0.5">
                                <ui:SymbolIcon.RenderTransform>
                                    <RotateTransform x:Name="ThemeIconRotation"/>
                                </ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="LanguageButton"
                               Appearance="Transparent"
                               anim:Hover.Effect="Pop"
                               ToolTip="{loc:Loc Shell_LanguageTooltip}"
                               Click="LanguageButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Translate24"/>
                        </ui:Button.Icon>
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="LanguageMenu" Placement="Bottom">
                                <MenuItem Header="{loc:Loc Shell_LanguagePtBr}" Click="PortugueseMenuItem_Click"/>
                                <MenuItem Header="{loc:Loc Shell_LanguageEnUs}" Click="EnglishMenuItem_Click"/>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Navegação por troca direta de conteúdo (ContentControl), não pelo
             gerenciamento interno de conteúdo do NavigationView — mais simples e
             previsível de verificar do que depender do comportamento interno dele. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8,12,8,8" VerticalAlignment="Top">
                <!-- Marcador da aba ativa. Desliza entre os botões em vez de simplesmente
                     acender no novo: o movimento é o que liga visualmente a aba que o
                     usuário deixou à que ele escolheu. -->
                <Border x:Name="NavIndicator"
                        Width="3"
                        Height="20"
                        Margin="0,11,0,0"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SystemAccentColorSecondaryBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorOffset"/>
                    </Border.RenderTransform>
                </Border>

                <StackPanel Margin="11,0,0,0"
                            anim:Entrance.ChildEffect="FadeFromLeft"
                            anim:Entrance.ChildStagger="70">
                    <ui:Button x:Name="CatalogNavButton"
                               Content="{loc:Loc Shell_NavCatalog}"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Height="42"
                               Margin="0,0,0,6"
                               anim:Hover.Effect="Glow"
                               Click="CatalogNavButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Grid24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="InstallNavButton"
                               Content="{loc:Loc Shell_NavInstall}"
                               Appearance="Transparent"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Height="42"
                               anim:Hover.Effect="Glow"
                               Click="InstallNavButton_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Desktop24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
