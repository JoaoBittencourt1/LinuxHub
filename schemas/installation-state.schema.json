{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linuxhub.example/schemas/installation-state.schema.json",
  "title": "LinuxHub Installation Execution State",
  "description": "Durable progress and compensation state for one installation plan (D4/D13.3). Shape only — ordering rules live in InstallationStateMachine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "revision",
    "status",
    "phase",
    "activeStep",
    "completedSteps",
    "compensatedSteps",
    "failure",
    "updatedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "failed",
        "rollback-running",
        "rolled-back",
        "succeeded"
      ]
    },
    "phase": {
      "enum": ["windows", "live", "target", "rollback", "complete"]
    },
    "activeStep": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "completedSteps": { "$ref": "#/$defs/stepList" },
    "compensatedSteps": { "$ref": "#/$defs/stepList" },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "progress": { "$ref": "#/$defs/progress" },
    "updatedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "stepList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(windows|live|target)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "component"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "component": {
          "enum": ["windows", "live", "target", "rollback"]
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "overallPercent"],
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "overallPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "detailPercent": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
